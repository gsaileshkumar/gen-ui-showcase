# Copy to .env and fill in. NEVER commit a real .env.
# Only OPENAI_API_KEY is required to run the demo end-to-end in mock mode.

# --- LLM ---
# Used by the LangGraph agent (Python) for GPT-4o tool-calling.
OPENAI_API_KEY=

# --- DHL ---
# mock  = (default) serve hand-built JSON fixtures matching real DHL schemas, offline-safe.
# live  = call developer.dhl.com endpoints; requires DHL_API_KEY.
DHL_MODE=mock
DHL_API_KEY=

# --- Wiring (rarely needs changing) ---
# Where the Next.js CopilotKit runtime route reaches the LangGraph agent.
NEXT_PUBLIC_AGENT_URL=http://localhost:8123/copilotkit
